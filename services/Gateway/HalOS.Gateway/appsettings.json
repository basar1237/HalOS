{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "party": {
        "ClusterId": "party",
        "Match": { "Path": "/api/party/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/party" }]
      },
      "sales": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/sales/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/sales" }]
      },
      "finance": {
        "ClusterId": "finance",
        "Match": { "Path": "/api/finance/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/finance" }]
      },
      "integration": {
        "ClusterId": "integration",
        "Match": { "Path": "/api/integration/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/integration" }]
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/inventory" }]
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/search" }]
      },
      "notification-hub": {
        "ClusterId": "notification",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },
      "ai": {
        "ClusterId": "ai",
        "Match": { "Path": "/ai/{**catch-all}" }
      }
    },

    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity:8080/" } }
      },
      "party": {
        "Destinations": { "primary": { "Address": "http://party:8080/" } }
      },
      "sales": {
        "Destinations": { "primary": { "Address": "http://sales:8080/" } }
      },
      "finance": {
        "Destinations": { "primary": { "Address": "http://finance:8080/" } }
      },
      "integration": {
        "Destinations": { "primary": { "Address": "http://integration:8080/" } }
      },
      "inventory": {
        "Destinations": { "primary": { "Address": "http://inventory:8080/" } }
      },
      "search": {
        "Destinations": { "primary": { "Address": "http://search:8080/" } }
      },
      "notification": {
        "Destinations": { "primary": { "Address": "http://notification:8080/" } }
      },
      "ai": {
        "Destinations": { "primary": { "Address": "http://ai-gateway:8080/" } }
      }
    }
  }
}
