<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HalOS.BuildingBlocks.Infrastructure</RootNamespace>
    <AssemblyName>HalOS.BuildingBlocks.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HalOS.BuildingBlocks.Application\HalOS.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\HalOS.BuildingBlocks.Contracts\HalOS.BuildingBlocks.Contracts.csproj" />
    <ProjectReference Include="..\HalOS.BuildingBlocks.Domain\HalOS.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <!-- Relational: outbox tablo/kolon adlandırması (ToTable/HasColumnName) — provider-nötr,
         tüm HalOS servisleri relational (Postgres). snake_case şema base'de merkezileşir (docs/05). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <!-- Asenkron event bus: RabbitMQ üzerinden MassTransit (docs/04 ADR-006). net8.0 uyumlu son
         kararlı 8.x. MassTransit'in KENDİ outbox'ı kullanılmaz — el-yapımı transactional outbox
         (OutboxDispatcher) korunur (docs/04 §10). -->
    <PackageReference Include="MassTransit" Version="8.5.10" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
