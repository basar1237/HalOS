<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-scoped package sources. <clear/> ensures machine-level private feeds
    (which may be unreachable outside the corporate network) do not break restore
    for this open-source-only solution. Add internal feeds here if/when needed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
