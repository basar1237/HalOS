# HalOS Konsol — Ortam Değişkenleri (örnek)
# Gerçek .env dosyaları koda yazılmaz (docs/04 §7).

# API Gateway (BFF) taban adresi — 04 §3 mikroservis haritası
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Notification servisi — canlı dashboard SignalR hub'ı (docs/06 S2.2).
# Tarayıcı /hubs/dashboard'a buradan bağlanır; JWT access_token query string ile taşınır.
NEXT_PUBLIC_NOTIFICATION_URL=http://localhost:5096
