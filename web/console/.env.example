# HalOS Konsol — Ortam Değişkenleri (örnek)
# Gerçek .env dosyaları koda yazılmaz (docs/04 §7).

# API Gateway (BFF) taban adresi — docs/04 §3. Tüm istemci istekleri buraya gider; Gateway
# ilgili servise yönlendirir. Yol öneki servise göre: /api/identity, /api/sales, /api/finance,
# /api/integration, /api/inventory, /api/party, /api/search; SignalR /hubs/dashboard.
# Gateway'i yerelde çalıştırın: services/Gateway (http://localhost:5000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Canlı dashboard SignalR hub'ı (docs/06 S2.2). Boş bırakılırsa Gateway tabanına düşer;
# hub Gateway üzerinden /hubs/dashboard olarak proxy'lenir. Gateway'siz doğrudan bağlanmak
# için Notification'a işaret edin (örn. http://localhost:5096).
# NEXT_PUBLIC_NOTIFICATION_URL=http://localhost:5000
