# HalOS — Yerel altyapı ortam değişkenleri (docs/04 §7: sır kaynak koda yazılmaz).
# Kullanım: bu dosyayı `.env` olarak kopyalayın ve gerekirse değerleri değiştirin.
#   cp .env.example .env
# NOT: Buradaki parolalar YALNIZCA yerel geliştirme içindir. Üretimde kullanmayın.

# -----------------------------------------------------------------------------
# PostgreSQL (birincil OLTP — ADR-007)
# -----------------------------------------------------------------------------
POSTGRES_USER=halos
POSTGRES_PASSWORD=halos_dev_pw
POSTGRES_DB=halos
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (cache / kilit — ADR-007)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=halos_dev_pw
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# RabbitMQ (event bus — ADR-006)
# -----------------------------------------------------------------------------
RABBITMQ_USER=halos
RABBITMQ_PASSWORD=halos_dev_pw
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Elasticsearch (arama — ADR-007). Dev'de xpack.security kapalı, parola yok.
# -----------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200

# -----------------------------------------------------------------------------
# MinIO (nesne deposu — ADR-007)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=halos
MINIO_ROOT_PASSWORD=halos_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Seq (yapısal log — Serilog -> Seq, 04 §8)
# -----------------------------------------------------------------------------
SEQ_UI_PORT=5341
SEQ_INGESTION_PORT=5342
# Opsiyonel: Seq admin parola hash'i (boş bırakılırsa ilk açılışta parola sorulmaz).
# Oluşturmak için: docker run --rm datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# Finance (Cari & Finans) servisi — yalnız `--profile apps` ile çalışır (M6).
# Servis kendi DB'sine (halos_finance) bağlanır; SaleCompleted'i RabbitMQ'dan tüketir.
# -----------------------------------------------------------------------------
FINANCE_PORT=5065
# JWT imza anahtarı YALNIZCA yerel geliştirme içindir; üretimde Vault/ortam değişkeninden (04 §7).
FINANCE_JWT_SIGNING_KEY=dev-only-signing-key-change-me-please-0123456789abcdef
