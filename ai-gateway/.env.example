# HalOS AI Gateway — ortam değişkeni örneği. Kopyalayın: cp .env.example .env
# Sır koda yazılmaz; tüm gizli değerler ortamdan gelir (docs/04 §7).

# --- Anthropic / Claude ---
# BOŞ bırakılabilir. Boşsa servis anahtarsız çalışır ve StubLlmClient devreye girer
# (gerçek Claude çağrısı YAPILMAZ). Anahtar geldiğinde gerçek Claude kullanılır.
ANTHROPIC_API_KEY=
# Varsayılan model (en güncel Sonnet). Değiştirmek zorunda değilsiniz.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Ortam (güvenlik politikası) ---
# development / staging / production. .NET (ASPNETCORE_ENVIRONMENT) ile uyumlu; APP_ENV
# öncelikli, yoksa ENVIRONMENT, yoksa ASPNETCORE_ENVIRONMENT okunur. HİÇBİRİ verilmezse
# GÜVENLİ VARSAYILAN "Production"dur → zayıf/varsayılan JWT anahtarı REDDEDİLİR (fail-fast).
APP_ENV=development

# --- JWT (ERP Identity ile AYNI) ---
# HS256 imza anahtarı: ERP servisleriyle BİREBİR aynı olmalı ki token'lar doğrulanabilsin.
# GÜVENLİK: Aşağıdaki varsayılan YALNIZ development içindir. Non-development (APP_ENV
# development değil) ortamda bu değer VEYA 32 bayttan kısa bir anahtar kullanılırsa servis
# başlangıçta RuntimeError ile durur (.NET JwtSigningKeyResolver ile simetrik). Üretimde
# güçlü, gizli bir anahtarı ortam değişkeni/Vault üzerinden sağlayın.
JWT__SIGNING_KEY=dev-only-signing-key-change-me-please-0123456789abcdef
JWT__ISSUER=HalOS.Identity
JWT__AUDIENCE=HalOS

# --- ERP SALT-OKUMA rapor uçları ---
ERP__SALES_BASE_URL=http://localhost:5055
ERP__FINANCE_BASE_URL=http://localhost:5065
# Opsiyonel servis-servis token'ı (normal akışta kullanıcı JWT'si iletilir).
# ERP__SERVICE_TOKEN=
ERP__REQUEST_TIMEOUT_SECONDS=10
