{
  "expo": {
    "name": "HalOS Patron",
    "slug": "halos-patron",
    "scheme": "halos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#166534"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.halos.patron"
    },
    "android": {
      "package": "com.halos.patron"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "router": {}
    }
  }
}
